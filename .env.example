# Copy to .env and fill in. NEVER commit a real key.
# These are the ONLY three model settings; everything else lives in config.toml.
# Any OpenAI-compatible chat-completions endpoint that supports tool calling works.

# Local Ollama (free, default for development):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# Hosted example (free tier), swap as needed:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=<your-key>
# LLM_MODEL=llama-3.3-70b-versatile

# Used by the evaluation harness to find the running service.
EVAL_BASE_URL=http://127.0.0.1:8000
